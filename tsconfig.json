{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node", "vscode"],
    "noEmit": true
  },
  "include": ["src/shared/**/*.ts", "src/core/**/*.ts", "src/extension/**/*.ts", "src/dev/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "vitest.config.ts"]
}
