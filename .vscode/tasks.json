{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "deepdive: build",
      "type": "shell",
      "command": "npm run build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "deepdive: watch",
      "type": "shell",
      "command": "npm run watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "deepdive",
        "pattern": { "regexp": "^✘ \\[ERROR\\] (.*)$", "message": 1 },
        "background": { "activesBegin": "^\\[build\\] watching", "beginsPattern": "^\\[build\\]", "endsPattern": "^\\[build\\] (watching|dist/.* ok)" }
      }
    }
  ]
}
